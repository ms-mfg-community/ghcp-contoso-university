@model Student
@using ContosoUniversity.Core.Models
@using ContosoUniversity.Web.Extensions

@{
    ViewBag.Title = "Details";
}

<h2>Details</h2>

<div>
    <h4>Student</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>
            @Html.DisplayNameFor(model => model.LastName)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.LastName)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.FirstMidName)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.FirstMidName)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.EnrollmentDate)
        </dt>
        <dd>
            @Html.DisplayFor(model => model.EnrollmentDate)
        </dd>
        <dt>
            @Html.DisplayNameFor(model => model.Enrollments)
        </dt>
        <dd>
            @if (Model.Enrollments != null && Model.Enrollments.Any())
            {
                <table class="table">
                    <tr>
                        <th>Course Title</th>
                        <th>Credits</th>
                        <th>Grade</th>
                    </tr>
                    @foreach (var item in Model.Enrollments)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Course.Title)
                            </td>
                            <td>
                                @item.Course.Credits
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Grade)
                            </td>
                        </tr>
                    }
                </table>

                var gradedEnrollments = Model.Enrollments
                    .Where(e => e.Grade.HasValue)
                    .ToList();

                if (gradedEnrollments.Any())
                {
                    var totalPoints = gradedEnrollments
                        .Sum(e => e.Grade!.Value.ToGradePoints() * e.Course.Credits);
                    var totalCredits = gradedEnrollments.Sum(e => e.Course.Credits);
                    var gpa = totalCredits > 0 ? totalPoints / totalCredits : 0;

                    <p><strong>GPA:</strong> @gpa.ToString("F2")</p>
                }
                else
                {
                    <p><strong>GPA:</strong> N/A</p>
                }
            }
            else
            {
                <p>No enrollments found.</p>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.ID">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
